# =====================================================================
# TaskFlow – Environment Configuration Template
# Copy this file to .env or configure config/database.php directly.
# Never commit actual production passwords or credentials to version control.
# =====================================================================

# Application Configuration
APP_NAME="TaskFlow"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/taskflow

# MySQL / MariaDB Database Configuration (Default XAMPP settings)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskflow_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session Security Configuration
SESSION_LIFETIME=7200

